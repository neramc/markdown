# Formatting rules, applied by most editors automatically.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 120 columns throughout. It is what the Kotlin and Rust sources are written to, and what the
# formatters below are configured for.
max_line_length = 120

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.rs]
# rustfmt's own default, and not negotiable through this file — recorded so editors agree with it.
max_line_length = 100

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so stripping them changes the document.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[gradlew.bat]
end_of_line = crlf

[Makefile]
indent_style = tab

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
