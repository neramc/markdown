<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quill.Uninstaller.ViewModels"
        x:Class="Quill.Uninstaller.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Uninstall Quill"
        Width="560" Height="360"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Styles>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource QuillMutedText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="26,26,26,12" Spacing="14">
            <TextBlock Classes="h1" Text="{Binding Headline}" />
            <TextBlock Classes="muted" Text="{Binding Detail}" />

            <StackPanel Spacing="8" IsVisible="{Binding IsRemoving}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="6" />
                <TextBlock Classes="muted" Text="{Binding ProgressStage}" />
            </StackPanel>

            <!-- Files that could not be deleted, so the user knows exactly what is left. -->
            <Border BorderBrush="{StaticResource QuillBorder}" BorderThickness="1" CornerRadius="4"
                    Padding="10" MaxHeight="140" IsVisible="{Binding HasLeftovers}">
                <ScrollViewer>
                    <SelectableTextBlock Text="{Binding Leftovers}" FontSize="11"
                                         FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource QuillFooterBackground}"
                BorderBrush="{StaticResource QuillBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,12">
                <Button Content="Uninstall" Command="{Binding RemoveClickedCommand}"
                        IsEnabled="{Binding CanRemove}" IsVisible="{Binding IsConfirm}"
                        Background="{StaticResource QuillDanger}" Foreground="White" />
                <Button Content="Cancel" Command="{Binding CloseCommand}" IsVisible="{Binding IsConfirm}" />
                <Button Content="Close" Command="{Binding CloseCommand}" IsVisible="{Binding IsFinished}"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
