<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kept separate from App.axaml so the headless UI tests can merge it and render the real window. -->
    <SolidColorBrush x:Key="QuillAccent" Color="#3574F0" />
    <SolidColorBrush x:Key="QuillDanger" Color="#DB5C5C" />
    <SolidColorBrush x:Key="QuillMutedText" Color="#6C707E" />
    <SolidColorBrush x:Key="QuillBorder" Color="#DFE1E5" />
    <SolidColorBrush x:Key="QuillFooterBackground" Color="#F2F3F5" />

</ResourceDictionary>
