<!--
    One screen.

    An installer for a text editor asks one question — where does it go — and everything else is a
    default somebody will accept. The six-page wizard this replaces (welcome, licence, scope,
    components, progress, finish) is a shape inherited from installing software off floppy disks,
    where each page was a real decision point. Modern Windows installers are a single panel with one
    button, and that is what this is: the destination, three checkboxes, and Install.

    The same window becomes the progress view and then the finish view rather than navigating
    anywhere, so nothing moves under the pointer and there is never a Back button to wonder about.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Quill.Installer.ViewModels"
        x:Class="Quill.Installer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Install Quill"
        Width="520" Height="400"
        MinWidth="520" MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Grid Margin="32,28,32,24" RowDefinitions="Auto,*,Auto">

        <!-- Identity. Name and version, once, at the top: the only branding an installer needs. -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Quill" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Version}" Opacity="0.6" FontSize="13" />
        </StackPanel>

        <!-- Ready: the one question, and the defaults. -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="16" IsVisible="{Binding IsReady}">
            <StackPanel Spacing="6">
                <TextBlock Text="Install location" FontSize="13" Opacity="0.75" />
                <Grid ColumnDefinitions="*,Auto" >
                    <TextBox Grid.Column="0" Text="{Binding TargetDirectory}" FontSize="13" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Default"
                            Command="{Binding UseDefaultDirectoryCommand}" />
                </Grid>
                <TextBlock Text="{Binding TargetDirectoryError}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding TargetDirectoryError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Add a Start menu shortcut" IsChecked="{Binding CreateStartMenuShortcut}" />
                <CheckBox Content="Add a desktop shortcut" IsChecked="{Binding CreateDesktopShortcut}" />
                <CheckBox Content="Open .md files with Quill" IsChecked="{Binding AssociateMarkdown}" />
            </StackPanel>

            <TextBlock Text="Installing for everybody on this machine needs administrator rights."
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                       IsVisible="{Binding RequiresElevation}" />

            <!-- An installer built with no payload is a real build output. Saying so beats an
                 Install button that produces a Quill-shaped empty folder. -->
            <TextBlock Text="This installer was built without an application payload, so there is nothing to install."
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding !HasPayload}" />
        </StackPanel>

        <!-- Installing: the same window, with the choices replaced by what is happening. -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="12"
                    VerticalAlignment="Center" IsVisible="{Binding IsProgress}">
            <TextBlock Text="{Binding ProgressStage}" FontSize="14" />
            <ProgressBar Value="{Binding ProgressFraction}" Maximum="1" Height="4" />
        </StackPanel>

        <!-- Done. -->
        <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="12"
                    VerticalAlignment="Center" IsVisible="{Binding IsFinish}">
            <TextBlock Text="{Binding FinishTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FinishDetail}" Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
            <CheckBox Content="Open Quill now" IsChecked="{Binding LaunchOnFinish}" />
        </StackPanel>

        <!-- Errors are shown where the eye already is rather than in a message box. -->
        <TextBlock Grid.Row="1" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

        <!-- One primary action, in the corner every Windows dialog puts it. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsReady}" />
            <Button Content="Install" Classes="accent" MinWidth="104"
                    Command="{Binding InstallCommand}" IsVisible="{Binding IsReady}"
                    IsEnabled="{Binding HasPayload}" />
            <Button Content="Close" Classes="accent" MinWidth="104"
                    Command="{Binding NextCommand}" IsVisible="{Binding IsFinish}" />
        </StackPanel>
    </Grid>
</Window>
